#include "../lib/huffmate-neo/src/tokens/ERC721.huff"
#include "../lib/huffmate-neo/src/data-structures/Hashmap.huff"

#define constant HORSE_HAPPY_IF_FED_WITHIN = 0x32 * 0x32 * 0x18 // 1 days

#define constant TOTAL_SUPPLY = FREE_STORAGE_POINTER()
#define constant HORSE_ID_TO_FED_TIMESTAMP_LOCATION = FREE_STORAGE_POINTER()

#define function mintHorse() nonpayable returns()
#define function totalSupply() nonpayable returns(uint256)
#define function feedHorse(uint256) nonpayable returns()
#define function isHappyHorse(uint256) view returns(bool)

// Mapping
#define function horseIdToFedTimeStamp(uint256) view returns(uint256)
// Constant
#define function HORSE_HAPPY_IF_FED_WITHIN() view returns(uint256)

#define macro CONSTRUCTOR() = takes (0) returns (0) {
    ERC721_CONSTRUCTOR()
}

#define macro MAIN() = takes(0) returns(0) {

    0x00 calldataload 0xe0 shr  // [func_sel]

    dup1 __FUNC_SIG(mintHorse) eq mintHorse jumpi
    dup1 __FUNC_SIG(feedHorse) eq feedHorse jumpi
    dup1 __FUNC_SIG(totalSupply) eq totalSupply jumpi 
    dup1 __FUNC_SIG(isHappyHorse) eq isHappyHorse jumpi 
    dup1 __FUNC_SIG(horseIdToFedTimeStamp) eq horseIdToFedTimeStamp jumpi
    dup1 __FUNC_SIG(HORSE_HAPPY_IF_FED_WITHIN) eq HORSE_HAPPY_IF_FED_WITHIN jumpi
    
    dup1 __FUNC_SIG(name) eq name jumpi 
    dup1 __FUNC_SIG(symbol) eq symbol jumpi 
    dup1 __FUNC_SIG(approve) eq approve jumpi 
    dup1 __FUNC_SIG(setApprovalForAll) eq setApprovalForAll jumpi 
    dup1 __FUNC_SIG(transferFrom) eq transferFrom jumpi 
    dup1 __FUNC_SIG(tokenURI) eq tokenURI jumpi 
    dup1 __FUNC_SIG(supportsInterface) eq supportsInterface jumpi 
    dup1 __FUNC_SIG(getApproved) eq getApproved jumpi 
    dup1 __FUNC_SIG(isApprovedForAll) eq isApprovedForAll jumpi 
    dup1 __FUNC_SIG(balanceOf) eq balanceOf jumpi 
    dup1 __FUNC_SIG(ownerOf) eq ownerOf jumpi 
    dup1 __FUNC_SIG(safeTransferFrom) eq safeTransferFrom jumpi 
    dup1 __FUNC_SIG(safeTransferFromData) eq safeTransferFromData jumpi 


    // 0x00 0x00 mstore
    0x00 0x00 revert

    mintHorse:
        MINT_HORSE()
    feedHorse:
        FEED_HORSE()
    isHappyHorse:
        IS_HAPPY_HORSE()
    totalSupply:
        GET_TOTAL_SUPPLY()
    horseIdToFedTimeStamp:
        HORSE_ID_TO_FED_TIMESTAMP()
    HORSE_HAPPY_IF_FED_WITHIN:
        HORSE_HAPPY_IF_FED_WITHIN()

    name:
        NAME()
    approve:
        APPROVE()
    setApprovalForAll:
        SET_APPROVAL_FOR_ALL()
    transferFrom:
        TRANSFER_FROM()
    symbol:
        SYMBOL()
    tokenURI:
        TOKEN_URI()
    supportsInterface:
        SUPPORTS_INTERFACE()
    getApproved:
        GET_APPROVED()
    isApprovedForAll:
        IS_APPROVED_FOR_ALL()
    balanceOf:
        BALANCE_OF()
    ownerOf:
        OWNER_OF()
    safeTransferFrom:
        SAFE_TRANSFER_FROM()
    safeTransferFromData:
        SAFE_TRANSFER_FROM_WITH_DATA()
    stop
}

#define macro GET_TOTAL_SUPPLY() = takes (0) returns (0) {
    [TOTAL_SUPPLY] sload // [totalSupply]
    0x00 mstore // [] MEM: [0x00: totalSupply]
    0x20 0x00 return  // [totalSupply]
}

#define macro MINT_HORSE() = takes(0) returns(0) {
    [TOTAL_SUPPLY] dup1 sload // [val, tokenId_slot]
    dup1 0x01 add // [0x01 + val, val, tokenId_slot]
    swap1 // [val, 0x01 + val, tokenId_slot]
    caller // [msg.sender, val, 0x01 + val, tokenId_slot]
    _MINT() // [0x01 + val, tokenId_slot]
    swap1 sstore
    stop    
}

#define macro FEED_HORSE() = takes(0) returns(0) {
    timestamp // [time]
    0x04 calldataload // [horseId, data]
    [HORSE_ID_TO_FED_TIMESTAMP_LOCATION] // [HORSE_ID_TO_FED_TIMESTAMP_LOCATION, horseId, time]
    STORE_ELEMENT_FROM_KEYS(0x00) // 0x00 is fmp // [sloy, key, data] stack input
    stop
}

#define macro IS_HAPPY_HORSE() = takes(0) returns(0) {
    0x04 calldataload // [horseId]
    _GET_HORSE_ID_TO_FED_TIMESTAMP() // [val]
    timestamp // [timestamp, val]
    dup2 dup2 // [timestamp, val, timestamp, val]
    sub // [timestamp - val, timestamp, val]
    [HORSE_HAPPY_IF_FED_WITHIN] // [1 days, timestamp - val, timestamp, val]
    gt // [1 days < timestamp - val, timestamp, val]
    returnTrue jumpi // [timestamp, val]
    eq // [timestamp == val]
    returning jump

    returnTrue:
        0x01 

    returning:    
        0x00 mstore 0x20 0x00 return
}

#define macro HORSE_ID_TO_FED_TIMESTAMP() = takes(0) returns(0) {
    0x04 calldataload // [horseId]
    _GET_HORSE_ID_TO_FED_TIMESTAMP() // [val]
    0x00 mstore
    0x20 0x00 return
    stop
}

#define macro HORSE_HAPPY_IF_FED_WITHIN() = takes(0) returns(0) {
    [HORSE_HAPPY_IF_FED_WITHIN] 0x00 mstore
    0x20 0x00 return
    stop   
}

#define macro _GET_HORSE_ID_TO_FED_TIMESTAMP() = takes(1) returns(1) {
    // input: [horseId]
    [HORSE_ID_TO_FED_TIMESTAMP_LOCATION] // [slot, horseId]
    LOAD_ELEMENT_FROM_KEYS(0x00)
}